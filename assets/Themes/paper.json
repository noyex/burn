    "lavender": { "pattern": { "type": "dots", "opacity": 0.2, "spacing": 8, "size": 1.2 } },
    "sky": { "pattern": { "type": "dots", "opacity": 0.2, "spacing": 8, "size": 1.2 } },
    "accent": { "pattern": { "type": "lines", "opacity": 0.1, "spacing": 8, "size": 0.8 } }
